# Qubify environment configuration

# Optional frontend API base URL.
# Leave empty when frontend and backend are served from the same domain.
# Example for separate deployment:
# VITE_API_BASE_URL=https://qubify-backend.onrender.com
VITE_API_BASE_URL=

# Allowed frontend origin(s) for backend requests.
# Multiple origins can be separated with commas.
# Production example:
# FRONTEND_URL=https://qubify.onrender.com
FRONTEND_URL=http://localhost:3000

# Arbitrary Python Code Lab execution.
# Keep false on public deployments unless proper sandboxing is added.
ENABLE_CODE_LAB=false

# Frontend flag used to show Public Demo mode in the Code Lab.
VITE_ENABLE_CODE_LAB=false
